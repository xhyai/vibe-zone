DOMAIN=devfest.atlasapx.pl
SECRET_KEY=replace-with-a-random-secret
ADMIN_PASSWORD=replace-with-a-long-admin-password
BOARD_SUBNET=10.231.41.0/24
BENCH_SUBNET=10.231.42.0/24
DOCKER_GID=0

# Standard runs require a bounded disk volume; no unbounded fallback.
BENCH_VOLUME_DRIVER=
BENCH_VOLUME_OPTIONS={}
BENCH_HOST_PROFILE=local-unverified
EDGE_SUBNET=10.231.40.0/24

# Test-only host: approve only the locally built organizer starter.
BENCH_SMOKE=1
BENCH_ALLOWED_IMAGE_IDS=

# Enable only after deploying and testing the outbound runner.
VZ_REMOTE_RUNNER=0
RUNNER_TOKEN=
